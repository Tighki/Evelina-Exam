<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="RestaurantOrders.App"
             RequestedThemeVariant="Light">
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
    <Style Selector="Window">
      <Setter Property="FontFamily" Value="Inter, sans-serif" />
    </Style>
    <Style Selector="Button.accent">
      <Setter Property="Background" Value="#1B3A4B" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.gold">
      <Setter Property="Background" Value="#C9852A" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="#E4EEF2" />
      <Setter Property="Foreground" Value="#1B3A4B" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Button.light">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="#E8A838" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Button.link">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#1B3A4B" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
  </Application.Styles>
</Application>
