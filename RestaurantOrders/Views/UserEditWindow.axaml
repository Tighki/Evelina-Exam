<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RestaurantOrders.Views.UserEditWindow"
        Width="440" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="22" Spacing="8">
    <TextBlock x:Name="TitleText" FontSize="22" FontWeight="Bold" Foreground="#6E2436" />
    <TextBlock Text="Логин" />
    <TextBox x:Name="LoginBox" />
    <TextBlock x:Name="PasswordLabel" Text="Пароль" />
    <TextBox x:Name="PasswordBox" PasswordChar="●" />
    <TextBlock Text="Роль" />
    <ComboBox x:Name="RoleBox" HorizontalAlignment="Stretch" />
    <TextBlock x:Name="ErrorText" Foreground="#9B2335" TextWrapping="Wrap" MinHeight="20" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
      <Button Classes="ghost" Content="Отмена" Click="OnCancel" />
      <Button Classes="accent" Content="Сохранить" Click="OnSave" />
    </StackPanel>
  </StackPanel>
</Window>
